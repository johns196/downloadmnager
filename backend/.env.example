# Copy to .env and adjust. Never bind HOST to anything but 127.0.0.1 --
# this backend has no auth and is meant for localhost-only use by the
# extension and the Flutter client running on the same machine.
HOST=127.0.0.1
PORT=8787
SNIFFER_SERVICE_URL=http://127.0.0.1:8788
DOWNLOADS_DIR=./downloads
DATA_DIR=./data
DB_PATH=./data/download-manager.db
MAX_CONCURRENT_JOBS=3
MAX_CHUNKS_PER_JOB=8
DEFAULT_CHUNKS_PER_JOB=4
